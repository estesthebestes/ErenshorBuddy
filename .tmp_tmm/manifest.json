{
    "manifest_version": 1,
    "type": "WebApp",
    "meta": {
        "name": "Thunderstore Mod Manager",
        "version": "1.113.0",
        "minimum-overwolf-version": "0.77.10",
        "author": "Thunderstore",
        "icon": "icons/icon.png",
        "icon_gray": "icons/icon-gray.png",
        "launcher_icon": "icons/icon.ico",
        "window_icon": "icons/taskbar.png",
        "description": "Thunderstore Mod Manager"
    },
    "permissions": [
        "Extensions",
        "Streaming",
        "Profile",
        "GameInfo",
        "Clipboard"
    ],
    "data": {
        "protocol_override_domains": {
            "googlesyndication": "http"
        },
        "start_window": "MainWindow",
        "process_name": "Thunderstore Mod Manager",
        "windows": {
            "MainWindow": {
                "file": "dist/index.html",
                "desktop_only": true,
                "native_window": true,
                "transparent": false,
                "resizable": true,
                "use_os_windowing": true,
                "size": {
                    "width": 1550,
                    "height": 720
                },
                "min_size": {
                    "width": 1350,
                    "height": 720
                },
                "mute": true,
                "popup_blocker": true,
                "block_top_window_navigation": true
            }
        },
        "externally_connectable": {
            "matches": [
                "https://thunderstore.io",
                "https://*.thunderstore.io",
                "https://cdn.thunderstore.io"
            ]
        },
        "extra-objects": {
            "downloader": {
                "file": "plugins/r2io.dll",
                "class": "r2io.Downloader"
            },
            "r2io-operations": {
                "file": "plugins/r2io.dll",
                "class": "r2io.FileOperations"
            },
            "r2io-info": {
                "file": "plugins/r2io.dll",
                "class": "r2io.FilesystemInformation"
            },
            "zipper": {
                "file": "plugins/Zipper.dll",
                "class": "Zipper.Zipper"
            },
            "zip-creator": {
                "file": "plugins/Zipper.dll",
                "class": "Zipper.ZipCreator"
            },
            "exec": {
                "file": "plugins/Exec.dll",
                "class": "Exec.Exec"
            },
            "image-migrator": {
                "file": "plugins/ImageMigration.dll",
                "class": "ImageMigration.Migrator"
            },
            "win-dialog": {
                "file": "plugins/r2io.dll",
                "class": "r2io.WinDialog"
            },
            "explorer-operations": {
                "file": "plugins/r2io.dll",
                "class": "r2io.ExplorerOperations"
            }
        },
        "url_protocol": {
            "scheme": "ror2mm"
        }
    }
}